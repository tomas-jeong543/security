+ remaining='Real-game B detection + self exit 2, projectile event linkage, angle/performance/false-positive measurements'
+}
+$result|ConvertTo-Json -Depth 8|Set-Content "$run/final-qa.json" -Encoding UTF8
+if($mismatches.Count -or !$result.tracked_diff_unchanged -or $checkExit -ne 0 -or $images.Count -ne 10 -or $changed.Count -ne 1 -or $changed[0] -ne 'word/document.xml' -or $extra.Count -ne 0){throw 'Final audit failed; inspect final-qa.json'}
+Write-Output ('Preserved '+$before.Count+' existing files; tracked diff unchanged; Word pages '+$images.Count)
+Write-Output ('Final report SHA256 '+$result.final_sha256)
