+$zip=[IO.Compression.ZipFile]::OpenRead($report);$rd=[IO.StreamReader]::new($zip.GetEntry('word/document.xml').Open());[xml]$xml=$rd.ReadToEnd();$rd.Close();$zip.Dispose()
