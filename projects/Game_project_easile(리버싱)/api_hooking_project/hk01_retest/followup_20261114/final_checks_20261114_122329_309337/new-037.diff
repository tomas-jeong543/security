++/* 분석한 빌드의 PE 형식, RVA 및 함수 진입 바이트 검사 */
++static BOOL verify_target_build(HMODULE game_exe)
++{
++    if (!verify_pinned_executable()) return FALSE;
++    static const BYTE expected[] = {
++        0x48, 0x8B, 0xC4, 0x48, 0x89, 0x58, 0x18,
++        0x55, 0x56, 0x57, 0x41, 0x54, 0x41, 0x55
++    };
++    if (!game_exe) return FALSE;
++
++    BYTE* base = (BYTE*)game_exe;
++    MEMORY_BASIC_INFORMATION mbi;
++    if (!VirtualQuery(base, &mbi, sizeof(mbi)) || mbi.State != MEM_COMMIT)
++        return FALSE;
++
++    SIZE_T offset = (SIZE_T)((uintptr_t)base - (uintptr_t)mbi.BaseAddress);
++    if (offset > mbi.RegionSize) return FALSE;
++    SIZE_T available = mbi.RegionSize - offset;
++    if (available < sizeof(IMAGE_DOS_HEADER)) return FALSE;
++
++    const IMAGE_DOS_HEADER* dos = (const IMAGE_DOS_HEADER*)base;
++    if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew <= 0)
++        return FALSE;
++
++    SIZE_T nt_offset = (SIZE_T)dos->e_lfanew;
++    if (nt_offset > available ||
++        sizeof(IMAGE_NT_HEADERS64) > available - nt_offset)
++        return FALSE;
++
++    const IMAGE_NT_HEADERS64* nt =
++        (const IMAGE_NT_HEADERS64*)(base + nt_offset);
++    if (nt->Signature != IMAGE_NT_SIGNATURE ||
++        nt->FileHeader.Machine != IMAGE_FILE_MACHINE_AMD64 ||
++        nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC)
++        return FALSE;
++
++    SIZE_T image_size = nt->OptionalHeader.SizeOfImage;
++    if (SPAWN_PROJECTILE_RVA >= image_size ||
++        sizeof(expected) > image_size - SPAWN_PROJECTILE_RVA)
++        return FALSE;
++
++    const BYTE* target = base + SPAWN_PROJECTILE_RVA;
++    MEMORY_BASIC_INFORMATION target_mbi;
++    if (!VirtualQuery(target, &target_mbi, sizeof(target_mbi)) ||
++        target_mbi.State != MEM_COMMIT ||
++        (target_mbi.Protect & (PAGE_GUARD | PAGE_NOACCESS)))
++        return FALSE;
++
++    SIZE_T target_offset = (SIZE_T)((uintptr_t)target - (uintptr_t)target_mbi.BaseAddress);
++    if (target_offset > target_mbi.RegionSize ||
++        sizeof(expected) > target_mbi.RegionSize - target_offset)
++        return FALSE;
++
++    return memcmp(target, expected, sizeof(expected)) == 0;
++}
